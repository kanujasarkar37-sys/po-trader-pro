# ─── PO Trader Pro — environment ─────────────────────────────────────────────
# Copy to .env (or .env.local) and adjust. Every variable is optional except
# DATABASE_URL (Prisma requires it; a sensible default is provided below).

# SQLite database location (Prisma). Paths are resolved RELATIVE TO prisma/,
# so file:../db/custom.db → <repo>/db/custom.db.
# Docker/Render images set an absolute path (file:/app/db/custom.db) instead.
DATABASE_URL=file:../db/custom.db

# ── Engine connection (browser → trading engine) ─────────────────────────────
# LOCAL TWO-PROCESS DEV (bun run dev + bun run engine): point the browser
# straight at the engine port. Leave unset to auto-detect (localhost → direct
# :3030, otherwise the sandbox gateway mode).
# NEXT_PUBLIC_ENGINE_URL=http://localhost:3030

# PRODUCTION SINGLE-SERVER (bun server.ts / Docker / Render): the engine is
# attached to the web server at /engine. The Dockerfile sets this at build
# time — only set it manually if you build outside Docker.
# NEXT_PUBLIC_ENGINE_PATH=/engine

# ── Engine service (standalone two-process mode) ─────────────────────────────
# Where the engine finds the Next.js API for persistence (default matches
# `bun run dev` on :3000; the consolidated server.ts sets it automatically).
# ENGINE_NEXT_API=http://localhost:3000/api

# ── Optional: Next.js telemetry ──────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
