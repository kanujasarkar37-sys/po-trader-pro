generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BotConfig {
  id             String   @id @default("main")
  ssid           String?
  derivToken     String?
  lastPlatform   String?   // 'deriv' | 'po' — auto-reconnect preference
  serverRegion   String   @default("api-l")
  demoMode       Boolean  @default(true)
  autoTrade      Boolean  @default(false)
  tradeAmount    Float    @default(1)
  minConfidence  Int      @default(65)
  expirySeconds  Int      @default(60)
  maxTrades      Int      @default(30)
  maxConcurrent  Int      @default(2)
  martingale     Boolean  @default(false)
  mgFactor       Float    @default(2)
  mgMaxSteps     Int      @default(3)
  stopLoss       Float    @default(50)
  takeProfit     Float    @default(100)
  selectedAssets String   @default("[]")
  newsFilter     Boolean  @default(true)
  dailyStopLoss  Float    @default(0)
  dailyProfitTarget Float @default(0)
  dynamicStake   Boolean  @default(false)
  adaptiveThresholds Boolean @default(false)
  updatedAt      DateTime @updatedAt
}

model Trade {
  id            String    @id @default(cuid())
  asset         String
  direction     String
  amount        Float
  payout        Float     @default(92)
  expirySeconds Int       @default(60)
  openPrice     Float?
  closePrice    Float?
  openTime      DateTime  @default(now())
  closeTime     DateTime?
  status        String    @default("open") // open | win | loss | draw
  profit        Float     @default(0)
  confidence    Int       @default(0)
  isDemo        Boolean   @default(true)
  requestId     String?
  source        String    @default("bot") // bot | manual | backtest
  createdAt     DateTime  @default(now())
}

model Signal {
  id            String   @id @default(cuid())
  asset         String
  direction     String
  confidence    Int
  expirySeconds Int      @default(60)
  indicators    String   @default("{}")
  acted         Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// AI Strategy Lab — user/AI generated rule strategies (rules + stats are JSON)
model Strategy {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  author      String   @default("user")
  rules       String   // JSON-encoded StrategyRules
  stats       String   @default("{}") // JSON {trades, winRate, profit, asset, testedAt}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
